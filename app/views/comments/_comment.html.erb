<li id="<%= dom_id(comment) %>" class="list-group-item">
  <div class="d-flex">
    <div class="flex-shrink-0">
      <%= image_tag comment.author.avatar_image.url, class: "rounded-circle me-2", width: 36 %>
    </div>
    <div class="flex-grow-1 ms-2">
      <div class="fw-bold">
        <%= link_to comment.author.username, user_path(comment.author.username), class: "text-dark link-underline-dark link-underline-opacity-0 link-underline-opacity-100-hover" %>
      </div>
      <%= simple_format comment.body %>
      <% if comment.author == current_user %>
        <div class="mt-2">
          <%= link_to edit_comment_path(comment), remote: true, class: "btn btn-link btn-sm text-muted" do %>
            <i class="fas fa-edit fa-fw"></i>
          <% end %>
          <%= button_to comment, method: :delete, remote: true, class: "btn btn-link btn-sm text-muted", form_class: "btn btn-sm btn-link" do %>
            <i class="fas fa-trash fa-fw"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</li>
